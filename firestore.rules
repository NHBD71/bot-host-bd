rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny global catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to fetch user data
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Is Admin Check - queries the user profile document with static short-circuit fallback for system owner
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "rootyou518@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Check if the document ID is syntactically secure
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validate User Entity
    function isValidUser(data) {
      return data.uid is string &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
        data.role is string && (data.role == "user" || data.role == "admin") &&
        data.plan is string && data.plan.size() > 0 && data.plan.size() <= 50 &&
        data.status is string && (data.status == "active" || data.status == "suspended" || data.status == "banned") &&
        (data.createdAt is timestamp || data.createdAt is string);
    }

    // Validate Bot Entity
    function isValidBot(data) {
      return data.botId is string &&
        data.ownerId is string &&
        data.botName is string && data.botName.size() > 0 && data.botName.size() <= 100 &&
        data.token is string && data.token.size() > 0 && data.token.size() <= 500 &&
        data.status is string && (data.status == "running" || data.status == "stopped" || data.status == "offline" || data.status == "build_failed") &&
        data.pythonVersion is string && (data.pythonVersion == "3.10" || data.pythonVersion == "3.11" || data.pythonVersion == "3.12") &&
        data.uptime is int &&
        (!('description' in data) || data.description is string) &&
        (!('autoRestart' in data) || data.autoRestart is bool) &&
        (!('envVars' in data) || data.envVars is string) &&
        data.createdAt is timestamp;
    }

    // Validate Ticket Entity
    function isValidTicket(data) {
      return data.ticketId is string &&
        data.userId is string &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
        data.status is string && (data.status == "open" || data.status == "replied" || data.status == "closed") &&
        data.createdAt is timestamp;
    }

    // Validate SubscriptionRequest Entity
    function isValidSubscriptionRequest(data) {
      return data.requestId is string &&
        data.userId is string &&
        data.userName is string &&
        data.userEmail is string &&
        data.planId is string &&
        data.planName is string &&
        (data.price is int || data.price is float || data.price is number) &&
        data.paymentMethod is string && (data.paymentMethod == "Bkash" || data.paymentMethod == "Nagad") &&
        data.senderNumber is string && data.senderNumber.size() >= 10 && data.senderNumber.size() <= 20 &&
        data.transactionId is string && data.transactionId.size() > 0 && data.transactionId.size() <= 100 &&
        data.status is string && (data.status == "pending" || data.status == "approved" || data.status == "rejected") &&
        (data.createdAt is timestamp || data.createdAt is string);
    }

    // Users Collection rules
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || 
        request.auth.token.email == "rootyou518@gmail.com" || (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role && 
          request.resource.data.plan == resource.data.plan &&
          request.resource.data.status == resource.data.status
        )
      );
      allow delete: if isAdmin();
    }

    // Bots Collection rules
    match /bots/{botId} {
      allow read: if true;
      
      allow create: if isSignedIn() && 
        isValidId(botId) &&
        isValidBot(request.resource.data) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.createdAt == request.time;
        
      allow update: if (isSignedIn() && (
        isAdmin() ||
        (resource.data.ownerId == request.auth.uid &&
         isValidBot(request.resource.data) &&
         request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.createdAt == resource.data.createdAt)
      )) || (
        request.auth == null
      );
      
      allow delete: if (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin())) || (request.auth == null);
    }

    // Plans Collection rules (Managed by Admin, readable by any logged-in user)
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Tickets Collection rules
    match /tickets/{ticketId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() &&
        isValidId(ticketId) &&
        isValidTicket(request.resource.data) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time;
        
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         isValidTicket(request.resource.data) &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.createdAt == resource.data.createdAt)
      );
      
      allow delete: if isAdmin();
    }

    // Announcements Collection rules (Readable by any logged-in user, writeable only by Admin)
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Subscription requests rules
    match /subscription_requests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        isValidSubscriptionRequest(request.resource.data) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending";
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
